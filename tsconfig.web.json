{
    "compilerOptions": {
        "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "strict": true, "noEmit": true,
        "skipLibCheck": true, "jsx": "react-jsx", "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "paths": { "@shared/*": ["./src/shared/*"], "@/*":["./src/renderer/src/*"] }
    }, 
    "include": ["src/renderer/src/**/*", "src/shared/**/*", "src/preload/index.d.ts"]
}
